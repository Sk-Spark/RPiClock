# Weather Configuration - NO API KEYS REQUIRED!
# Using free weather APIs: wttr.in and open-meteo.com

# Location coordinates for weather data (currently set to Hyderabad, India)
# Change these coordinates to your desired location:
# Example locations:
# - Hyderabad, India: 17.3968, 78.3348
# - New York, USA: 40.7128, -74.0060
# - London, UK: 51.5074, -0.1278
# - Sydney, Australia: -33.8688, 151.2093
VITE_DEFAULT_LAT=17.3968
VITE_DEFAULT_LON=78.3348

# Optional: Weather update interval in seconds (default: 300 = 5 minutes)
VITE_WEATHER_UPDATE_INTERVAL=300

# Note: Weather data is now completely free!
# Primary: wttr.in (world weather data)
# Fallback: open-meteo.com (European weather service)
# Location names are fetched automatically from coordinates using bigdatacloud.net